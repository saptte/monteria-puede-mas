{
  "name": "monteria-puede-mas-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @mpm/shared build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm --filter @mpm/shared build && pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev:gateway": "pnpm --filter @mpm/gateway dev",
    "db:up": "docker compose up -d"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9"
}
